{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/f3ar/browser"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(?:js|css|map|png|jpg|jpeg|gif|svg|ico|json|txt|woff|woff2|ttf|eot))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
